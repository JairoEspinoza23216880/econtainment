[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"emission_standards"
branch = 1
title = "Norma Base de Emisiones"
description = "Marco legal mínimo que fija topes a chimeneas, descargas y manejo de residuos peligrosos.\n\nEn la vida real: Pone reglas claras para frenar las descargas industriales más graves, aunque requiere inspectores constantes para que las empresas las cumplan."
pros_text = "Frena el crecimiento de emisiones industriales en la Zona Productiva."
cons_text = "Requiere cuerpo de inspección mensual."
prerequisites = Array[StringName]([])
cost_budget = 12
maintenance_per_tick = 1
delay_ticks = 0
immediate_trust_delta = 0.0
productive_emission_delta = -1.5
