[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"circular_incentives"
branch = 1
title = "Fomento a la Economía Circular"
description = "Programa avanzado de deducciones para que las industrias reutilicen insumos, empaques y traten su propia agua.\n\nEn la vida real: Consolida cadenas industriales sustentables con buena aceptación social, aunque exige una fuerte inversión pública inicial y tiempo de adaptación."
pros_text = "Solución estable y permanente sin conflicto social."
cons_text = "Alto coste inicial y tarda 2 meses en activarse."
prerequisites = Array[StringName]([&"green_tax_incentives"])
cost_budget = 30
maintenance_per_tick = 2
delay_ticks = 2
immediate_trust_delta = 3.0
productive_emission_delta = -2.0
productive_mitigation_delta = 1.8
