[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"circular_incentives"
branch = 1
title = "Fomento y Economía Circular"
description = "Deducciones fiscales a industrias que traten su propia agua y reciclen insumos."
pros_text = "Cero costo de Confianza; solución permanente, limpia y estable."
cons_text = "Alto coste de presupuesto inicial; tarda 2 ticks en activarse."
prerequisites = Array[StringName]([&"emission_standards"])
cost_budget = 32
maintenance_per_tick = 2
delay_ticks = 2
immediate_trust_delta = 3.0
productive_emission_delta = -2.5
productive_mitigation_delta = 2.0
