[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"punitive_closures"
branch = 1
title = "Clausuras por Reincidencia"
description = "Sanciones severas y sellos de clausura a empresas que violen las restricciones de uso de suelo, vertidos o emisiones.\n\nEn la vida real: Corta de inmediato focos tóxicos graves, pero provoca paros, pérdida de empleos y un fuerte rechazo social y empresarial."
pros_text = "Corte inmediato y fuerte de contaminación en Zona Productiva."
cons_text = "Muy impopular: paros y despidos restan 12% de Confianza de golpe y reducen el ingreso mensual."
prerequisites = Array[StringName]([&"restrictive_land_use"])
cost_budget = 18
maintenance_per_tick = 2
delay_ticks = 0
immediate_trust_delta = -12.0
budget_income_penalty = 1
productive_emission_delta = -2.8
productive_mitigation_delta = 1.5
