[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"zero_discharge_mandate"
branch = 1
title = "Mandato de Cero Descargas"
description = "Ley integral que obliga a operar en circuito cerrado de agua y costear el saneamiento de cualquier derrame.\n\nEn la vida real: Protege de forma definitiva las cuencas y obliga al sector privado a responder por sus daños, aunque genera presión política y altos costos de supervisión."
pros_text = "Mitigación muy alta en Zona Productiva y Reserva Biológica para cerrar por vía legal."
cons_text = "Coste alto, mantenimiento mensual y tensión política moderada."
prerequisites = Array[StringName]([&"punitive_closures", &"circular_incentives"])
cost_budget = 36
maintenance_per_tick = 3
delay_ticks = 1
immediate_trust_delta = -4.0
productive_mitigation_delta = 2.5
reserve_mitigation_delta = 2.5
