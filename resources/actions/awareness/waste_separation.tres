[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"waste_separation"
branch = 0
title = "Separación Casera de Residuos"
description = "Fomenta en los hogares la separación de reciclables y la entrega de aceite usado en puntos de acopio.\n\nEn la vida real: Disminuye los desechos domésticos y evita que el aceite tape drenajes, aunque requiere constancia ciudadana y logística municipal para mantener los centros de acopio."
pros_text = "Bajo coste; reduce gradualmente la carga doméstica en la Zona Urbana y mejora la Confianza."
cons_text = "Requiere sostener puntos de acopio mensuales."
prerequisites = Array[StringName]([])
cost_budget = 10
maintenance_per_tick = 1
delay_ticks = 0
immediate_trust_delta = 3.0
urban_emission_delta = -1.2
