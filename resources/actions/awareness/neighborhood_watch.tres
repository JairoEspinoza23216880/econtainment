[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"neighborhood_watch"
branch = 0
title = "Vigilancia Digital Vecinal"
description = "Fomenta la participación vecinal mediante una app para reportar tiraderos, fugas y oportunidades comunitarias en las tres zonas.\n\nEn la vida real: Convierte a los vecinos en ojos del territorio para detectar descargas ilegales a tiempo, pero su éxito depende totalmente de la confianza ciudadana y del seguimiento rápido."
pros_text = "Aumenta el ratio de aparición de burbujas según tu Confianza Ciudadana y apoya la mitigación en Zona Productiva."
cons_text = "Si la Confianza cae demasiado, baja la participación vecinal; las alertas ignoradas penalizan el doble."
prerequisites = Array[StringName]([&"waste_separation"])
cost_budget = 16
maintenance_per_tick = 2
delay_ticks = 0
immediate_trust_delta = 2.0
productive_mitigation_delta = 1.0
grants_early_alert = true
missed_alert_penalty_multiplier = 2.0
