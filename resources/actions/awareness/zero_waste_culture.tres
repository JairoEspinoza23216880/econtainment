[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"zero_waste_culture"
branch = 0
title = "Cultura Cero Residuos"
description = "Impulsa el compostaje barrial, el rescate de alimentos y la sustitución de desechables en toda la ciudad."
pros_text = "Fuerte reducción de residuos urbanos y aumento de Confianza."
cons_text = "Tarda 1 mes en consolidar el cambio de hábitos."
prerequisites = Array[StringName]([&"selective_boycott"])
cost_budget = 20
maintenance_per_tick = 1
delay_ticks = 1
immediate_trust_delta = 3.0
urban_emission_delta = -1.8
