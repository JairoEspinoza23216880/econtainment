[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"selective_boycott"
branch = 0
title = "Consumo Crítico Responsable"
description = "Promueve en redes ciudadanas y universitarias el rechazo a productos con empaques contaminantes.\n\nEn la vida real: Presiona a comercios e industrias a reducir plásticos sin construir infraestructura pública, pero genera tensiones con cámaras comerciales y frena temporalmente la actividad económica."
pros_text = "Incentiva a comercios e industrias a reducir plásticos y suma Confianza."
cons_text = "Genera fricción con cámaras comerciales y reduce el ingreso mensual."
prerequisites = Array[StringName]([&"waste_separation"])
cost_budget = 15
maintenance_per_tick = 1
delay_ticks = 0
immediate_trust_delta = 3.0
budget_income_penalty = 2
productive_emission_delta = -1.0
urban_emission_delta = -1.2
