[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"productive_tech_conversion"
branch = 2
title = "Reconversión Tecnológica Productiva"
description = "Programa público para sustituir hornos obsoletos e instalar biodigestores que evitan emisiones desde la fuente.\n\nEn la vida real: Moderniza talleres y granjas para contaminar mucho menos sin cerrar empleos, pero requiere tiempo de obra y presupuesto constante."
pros_text = "Reduce emisiones productivas de raíz sin desgaste político."
cons_text = "Tarda 2 meses en instalarse y se suspende si el presupuesto llega a $0."
prerequisites = Array[StringName]([&"emergency_crews"])
cost_budget = 20
maintenance_per_tick = 2
delay_ticks = 2
immediate_trust_delta = 0.0
productive_emission_delta = -2.0
requires_positive_budget = true
