[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"bio_remediation"
branch = 2
title = "Remediación Biológica y Humedales"
description = "Reforestación de riberas y construcción de humedales artificiales en la Reserva."
pros_text = "Desbloquea la tasa más alta de regeneración neta negativa y aumenta la Confianza."
cons_text = "Tarda en madurar; si ocurre un derrame severo, el humedal muere y debe reconstruirse."
prerequisites = Array[StringName]([&"emergency_crews"])
cost_budget = 28
maintenance_per_tick = 0
delay_ticks = 2
immediate_trust_delta = 6.0
reserve_regen_delta = 4.5
vulnerable_to_severe_spill = true
