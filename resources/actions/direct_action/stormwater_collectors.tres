[gd_resource type="Resource" script_class="ActionData" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/data/action_data.gd" id="1_action"]

[resource]
script = ExtResource("1_action")
id = &"stormwater_collectors"
branch = 2
title = "Colectores de Desagüe Pluvial"
description = "Infraestructura gris para confinar residuos sólidos en celdas sanitarias y canalizar descargas antes del río.\n\nEn la vida real: Evita que basura y aguas sucias lleguen directo al río, pero depende de presupuesto continuo para operar y mantenerse."
pros_text = "Mitigación directa en Zona Urbana y Reserva Biológica."
cons_text = "Requiere mantenimiento mensual y se suspende si el presupuesto llega a $0."
prerequisites = Array[StringName]([&"emergency_crews"])
cost_budget = 20
maintenance_per_tick = 2
delay_ticks = 1
immediate_trust_delta = 0.0
urban_mitigation_delta = 1.6
reserve_mitigation_delta = 1.4
requires_positive_budget = true
